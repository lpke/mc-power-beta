{
  "schemaVersion": 1,
  "id": "lpkecreative",
  "version": "${version}",
  "name": "LpkeCreative",
  "description": "Creative flight, spectator mode and creative inventory for Minecraft Beta 1.7.3.",
  "authors": [
    "lpke",
    "paulevs (BHCreative)"
  ],
  "contact": {
    "sources": "https://github.com/lpke/mc-lpkecreative",
    "issues": "https://github.com/lpke/mc-lpkecreative/issues"
  },
  "license": "MIT",
  "icon": "assets/lpkecreative/icon.png",
  "environment": "client",
  "entrypoints": {
    "stationapi:event_bus_client": [
      "paulevs.bhcreative.listeners.ClientInitListener",
      "local.luke.creative.Reach"
    ],
    "stationapi:event_bus": [
      "paulevs.bhcreative.listeners.CommonInitListener"
    ],
    "bhcreative:event_bus": [
      "paulevs.bhcreative.listeners.VanillaTabListener"
    ],
    "modmenu": [
      "local.luke.creative.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "bhcreative.mixins.common.json",
    "bhcreative.mixins.client.json",
    "lpkecreative.mixins.json"
  ],
  "depends": {
    "minecraft": "1.0.0-beta.7.3",
    "stationapi": ">=2.0-alpha.4",
    "mixinextras": ">=0.5.0",
    "java": ">=17"
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/class_54": [
        "paulevs/bhcreative/interfaces/CreativePlayer"
      ],
      "net/minecraft/class_591": [
        "paulevs/bhcreative/interfaces/CreativeLevel"
      ],
      "net/minecraft/class_7": [
        "paulevs/bhcreative/interfaces/CreativeLevel"
      ]
    }
  },
  "provides": [
    "bhcreative"
  ],
  "breaks": {
    "bhcreative": "<1.0.0"
  }
}
