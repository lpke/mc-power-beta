{
  "schemaVersion": 1,
  "id": "lpketweaks",
  "version": "${version}",
  "name": "LpkeTweaks",
  "description": "Building, movement, camera and mining controls for Beta 1.7.3.",
  "authors": [
    "Luke"
  ],
  "license": "LGPL-3.0-only",
  "environment": "client",
  "icon": "assets/lpketweaks/icon.png",
  "entrypoints": {
    "modmenu": [
      "local.luke.tweaks.config.ModMenuIntegration"
    ]
