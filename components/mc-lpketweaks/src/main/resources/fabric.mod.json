  },
  "breaks": {
    "beta_autowalk": "*",
    "beta_transport": "*",
    "beta_fastplace": "*",
    "beta_flexible_placement": "*",
    "beta_fake_sneak": "*",
    "beta_slab_placement": "*",
    "omnilook": "*",
    "click-mining-forever": "*"
