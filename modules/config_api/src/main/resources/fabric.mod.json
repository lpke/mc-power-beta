{
  "schemaVersion": 1,
  "id": "gcapi3",
  "version": "${version}",
  "name": "Power Beta Configuration",
  "description": "Shared settings storage and compatibility API.",
  "authors": [
    "calmilamsy"
  ],
  "contact": {
    "sources": "https://github.com/lpke/mc-power-beta"
  },
  "license": "CC0-1.0",
  "icon": "assets/gcapi3/icon.png",
  "environment": "*",
  "entrypoints": {
