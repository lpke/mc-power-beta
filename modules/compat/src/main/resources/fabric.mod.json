{
  "schemaVersion": 1,
  "id": "power_compat",
  "version": "${version}",
  "name": "Power Beta Compat",
  "description": "Provides features from incompatible mods of mine to ControlFeatures.",
  "icon": "assets/power_compat/icon.png",
  "environment": "*",
  "entrypoints": {
    "gcapi3": [
      "local.luke.power.compat.Config"
    ]
  },
  "mixins": [
    "power_compat.mixins.json"
  ],
  "depends": {
    "minecraft": "1.0.0-beta.7.3",
    "gcapi3": ">=3.0.2",
    "stationapi": "*"
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/class_54": [
        "local/luke/power/compat/VehicleInterface"
      ]
    }
  }
}
